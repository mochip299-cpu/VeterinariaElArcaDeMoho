@page "{id:int}"
@model Veterinaria.Pages.Veterinarios.DetailsModel
@{
    ViewData["Title"] = "Detalle del veterinario";
    var v = Model.Veterinario!;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title"><i class="bi bi-hospital me-2"></i>@v.NombreCompleto</h1>
        <p class="page-subtitle">@v.Especialidad</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Edit" asp-route-id="@v.Id" class="btn btn-warning">
            <i class="bi bi-pencil me-1"></i> Editar
        </a>
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card card-arca">
            <div class="card-header card-header-arca">
                <i class="bi bi-person-badge me-2"></i>Datos del veterinario
            </div>
            <div class="card-body">
                <dl class="detail-list">
                    <dt>Nombre completo</dt>
                    <dd>@v.NombreCompleto</dd>
                    <dt>Especialidad</dt>
                    <dd>@v.Especialidad</dd>
                    <dt>Teléfono</dt>
                    <dd><i class="bi bi-telephone me-1 text-muted"></i>@v.Telefono</dd>
                    <dt>Estado</dt>
                    <dd>
                        @if (v.Estado == Veterinaria.Models.EstadoGeneral.Activo)
                        { <span class="badge badge-activo">Activo</span> }
                        else
                        { <span class="badge badge-inactivo">Inactivo</span> }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card card-arca">
            <div class="card-header card-header-arca">
                <i class="bi bi-calendar2-check me-2"></i>Citas atendidas (@v.Citas.Count)
            </div>
            <div class="card-body p-0">
                @if (!v.Citas.Any())
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-calendar-x" style="font-size:2rem"></i>
                        <p class="mt-2">No hay citas registradas para este veterinario.</p>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var c in v.Citas.OrderByDescending(x => x.FechaHoraAtencion))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@c.Mascota?.Nombre</div>
                                    <small class="text-muted">@c.FechaHoraAtencion.ToString("dd/MM/yyyy HH:mm") · @c.Motivo</small>
                                </div>
                                @{
                                    var cls = c.Estado switch {
                                        Veterinaria.Models.EstadoCita.Completada => "badge-completada",
                                        Veterinaria.Models.EstadoCita.Cancelada  => "badge-cancelada",
                                        _                                         => "badge-pendiente"
                                    };
                                }
                                <span class="badge @cls">@c.Estado</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
