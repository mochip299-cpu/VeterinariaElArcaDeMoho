@page
@model Veterinaria.Pages.Veterinarios.CreateModel
@{
    ViewData["Title"] = "Nuevo veterinario";
}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-person-plus-fill me-2"></i>Nuevo veterinario</h1>
    <p class="page-subtitle">Complete los datos del nuevo profesional</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-arca">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Veterinario.Nombre" class="form-label fw-semibold"></label>
                            <input asp-for="Veterinario.Nombre" class="form-control" placeholder="Ej: Ana" autofocus />
                            <span asp-validation-for="Veterinario.Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Veterinario.Apellido" class="form-label fw-semibold"></label>
                            <input asp-for="Veterinario.Apellido" class="form-control" placeholder="Ej: Rodríguez" />
                            <span asp-validation-for="Veterinario.Apellido" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Veterinario.Especialidad" class="form-label fw-semibold"></label>
                            <input asp-for="Veterinario.Especialidad" class="form-control" placeholder="Ej: Medicina general, Cirugía…" />
                            <span asp-validation-for="Veterinario.Especialidad" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Veterinario.Telefono" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Veterinario.Telefono" class="form-control" placeholder="8888-0000" />
                            </div>
                            <span asp-validation-for="Veterinario.Telefono" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Veterinario.Estado" class="form-label fw-semibold"></label>
                            <select asp-for="Veterinario.Estado"
                                    asp-items="Html.GetEnumSelectList<Veterinaria.Models.EstadoGeneral>()"
                                    class="form-select"></select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-arca">
                            <i class="bi bi-floppy me-1"></i> Guardar
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
