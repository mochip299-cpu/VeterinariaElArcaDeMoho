<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — El Arca de Moe</title>
    <script type="importmap"></script>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Estilos propios -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Veterinaria.styles.css" asp-append-version="true" />
</head>
<body>

<!-- Sidebar -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-brand">
        <i class="bi bi-heart-pulse-fill me-2"></i>
        <span>El Arca de Moe</span>
    </div>

    <nav class="sidebar-nav">
        <div class="sidebar-section">Principal</div>
        <a class="sidebar-link @(ViewData["Title"]?.ToString() == "Dashboard" ? "active" : "")"
           asp-page="/Index">
            <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
        </a>

        <div class="sidebar-section">Gestión</div>
        <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Citas") == true ? "active" : "")"
           asp-page="/Citas/Index">
            <i class="bi bi-calendar2-check"></i><span>Citas</span>
        </a>
        <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Mascotas") == true ? "active" : "")"
           asp-page="/Mascotas/Index">
            <i class="bi bi-heart-fill"></i><span>Mascotas</span>
        </a>
        <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Propietarios") == true ? "active" : "")"
           asp-page="/Propietarios/Index">
            <i class="bi bi-people-fill"></i><span>Propietarios</span>
        </a>
        <a class="sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Veterinarios") == true ? "active" : "")"
           asp-page="/Veterinarios/Index">
            <i class="bi bi-hospital"></i><span>Veterinarios</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <small>&copy; @DateTime.Now.Year El Arca de Moe</small>
    </div>
</div>

<!-- Contenido principal -->
<div class="main-wrapper">
    <!-- Topbar -->
    <header class="topbar">
        <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggle">
            <i class="bi bi-list fs-5"></i>
        </button>
        <div class="topbar-title d-none d-lg-block">@ViewData["Title"]</div>
        <div class="ms-auto d-flex align-items-center gap-3">
            <a asp-page="/Citas/Create" class="btn btn-primary btn-sm btn-arca d-none d-md-inline-flex">
                <i class="bi bi-plus-lg me-1"></i>Nueva cita
            </a>
            <!-- Usuario logueado -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2"
                            type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i>
                        <span class="d-none d-md-inline">@User.Identity.Name</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-item-text small text-muted">@User.Identity.Name</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" asp-page="/Auth/Logout">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            <!-- Toggle tema -->
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-moon-stars-fill theme-icon-dark text-muted small"></i>
                <i class="bi bi-sun-fill theme-icon-light small" style="color:#f59e0b"></i>
                <button class="theme-toggle" id="themeToggle" title="Cambiar tema" aria-label="Cambiar tema"></button>
            </div>
        </div>
    </header>

    <!-- Alertas TempData -->
    <div class="px-4 pt-3">
        @if (TempData["Exito"] is string exito)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@exito
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>@error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Página -->
    <main class="main-content">
        @RenderBody()
    </main>
</div>

<!-- Scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    // Toggle sidebar en móvil
    document.getElementById('sidebarToggle')?.addEventListener('click', () => {
        document.getElementById('sidebar').classList.toggle('open');
    });

    // ── Toggle tema claro / oscuro ─────────────────────
    const toggle = document.getElementById('themeToggle');
    const body   = document.body;

    // Aplicar tema guardado al cargar
    if (localStorage.getItem('tema') === 'light') {
        body.classList.add('light-mode');
    }

    toggle?.addEventListener('click', () => {
        body.classList.toggle('light-mode');
        localStorage.setItem('tema', body.classList.contains('light-mode') ? 'light' : 'dark');
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
