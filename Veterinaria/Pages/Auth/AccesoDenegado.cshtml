@page
@{
    ViewData["Title"] = "Acceso denegado";
    Layout = "~/Pages/Shared/_LayoutAuth.cshtml";
}

<div class="auth-card text-center">
    <i class="bi bi-shield-lock-fill text-danger" style="font-size:4rem"></i>
    <h2 class="auth-title mt-3">Acceso denegado</h2>
    <p class="auth-subtitle">No tenés permiso para acceder a esta página.</p>
    <a asp-page="/Index" class="btn btn-primary btn-arca mt-3">
        <i class="bi bi-house me-2"></i>Volver al inicio
    </a>
</div>
