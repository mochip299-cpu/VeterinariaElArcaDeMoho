@page
@model Veterinaria.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var s = Model.Stats;
}

<!-- Hero -->
<div class="dashboard-hero mb-4">
    <div class="d-flex align-items-center gap-3">
        <img src="~/images/paw.svg" alt="pata" class="hero-icon" />
        <div>
            <h1 class="hero-title mb-0">El Arca de Moe</h1>
            <p class="hero-subtitle mb-0">Clínica Veterinaria — Panel de control</p>
        </div>
    </div>
    <p class="hero-date mt-2">
        <i class="bi bi-calendar3 me-1"></i>
        @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))
    </p>
</div>

@if (Model.CitasPasadasPendientes > 0)
{
    <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Atención:</strong> Hay <strong>@Model.CitasPasadasPendientes</strong> cita(s) con fecha pasada que siguen en estado <em>Pendiente</em>.
        <a asp-page="/Citas/Index" class="alert-link ms-2">Revisar citas</a>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Tarjetas de estadísticas -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
            <div class="stat-value">@s.TotalPropietarios</div>
            <div class="stat-label">Propietarios</div>
            <div class="stat-sub">@s.PropietariosActivos activos</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-pink">
            <div class="stat-icon"><i class="bi bi-heart-fill"></i></div>
            <div class="stat-value">@s.TotalMascotas</div>
            <div class="stat-label">Mascotas</div>
            <div class="stat-sub">@s.MascotasActivas activas</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-green">
            <div class="stat-icon"><i class="bi bi-hospital"></i></div>
            <div class="stat-value">@s.TotalVeterinarios</div>
            <div class="stat-label">Veterinarios</div>
            <div class="stat-sub">@s.VeterinariosActivos activos</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card stat-orange">
            <div class="stat-icon"><i class="bi bi-calendar-check"></i></div>
            <div class="stat-value">@s.CitasHoy</div>
            <div class="stat-label">Citas hoy</div>
            <div class="stat-sub">@s.CitasPendientes pendientes</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Citas de hoy -->
    <div class="col-lg-8">
        <div class="card card-arca">
            <div class="card-header card-header-arca d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock me-2"></i>Citas de hoy</span>
                <a asp-page="/Citas/Index" class="btn btn-sm btn-outline-primary">Ver todas</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.CitasHoy.Any())
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-calendar-check" style="font-size:2.5rem"></i>
                        <p class="mt-2">No hay citas programadas para hoy.</p>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var c in Model.CitasHoy)
                        {
                            var cls = c.Estado switch {
                                Veterinaria.Models.EstadoCita.Completada => "badge-completada",
                                Veterinaria.Models.EstadoCita.Cancelada  => "badge-cancelada",
                                _                                         => "badge-pendiente"
                            };
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="cita-hora">@c.FechaHoraAtencion.ToString("HH:mm")</div>
                                    <div>
                                        <div class="fw-semibold">@c.Mascota?.Nombre
                                            <small class="text-muted fw-normal">(@c.Mascota?.Especie)</small>
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-hospital me-1"></i>@c.Veterinario?.NombreCompleto
                                            &nbsp;·&nbsp; @c.Motivo
                                        </small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @cls">@c.Estado</span>
                                    <a asp-page="/Citas/Details" asp-route-id="@c.Id"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <!-- Resumen de citas + accesos rápidos -->
    <div class="col-lg-4">
        <!-- Resumen por estado -->
        <div class="card card-arca mb-3">
            <div class="card-header card-header-arca">
                <i class="bi bi-bar-chart me-2"></i>Resumen de citas
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span><span class="badge badge-pendiente me-2">●</span>Pendientes</span>
                    <strong>@s.CitasPendientes</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span><span class="badge badge-completada me-2">●</span>Completadas</span>
                    <strong>@s.CitasCompletadas</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span><span class="badge badge-cancelada me-2">●</span>Canceladas</span>
                    <strong>@s.CitasCanceladas</strong>
                </div>
            </div>
        </div>

        <!-- Accesos rápidos -->
        <div class="card card-arca">
            <div class="card-header card-header-arca">
                <i class="bi bi-lightning-charge me-2"></i>Acceso rápido
            </div>
            <div class="card-body d-grid gap-2">
                <a asp-page="/Citas/Create" class="btn btn-primary btn-arca">
                    <i class="bi bi-calendar-plus me-2"></i>Nueva cita
                </a>
                <a asp-page="/Propietarios/Create" class="btn btn-outline-primary">
                    <i class="bi bi-person-plus me-2"></i>Nuevo propietario
                </a>
                <a asp-page="/Mascotas/Create" class="btn btn-outline-primary">
                    <i class="bi bi-plus-circle me-2"></i>Nueva mascota
                </a>
                <a asp-page="/Veterinarios/Create" class="btn btn-outline-secondary">
                    <i class="bi bi-person-plus me-2"></i>Nuevo veterinario
                </a>
            </div>
        </div>
    </div>
</div>
