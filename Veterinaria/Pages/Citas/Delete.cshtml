@page "{id:int}"
@model Veterinaria.Pages.Citas.DeleteModel
@{
    ViewData["Title"] = "Eliminar cita";
    var c = Model.Cita!;
}

<div class="page-header">
    <h1 class="page-title text-danger"><i class="bi bi-trash me-2"></i>Eliminar cita</h1>
    <p class="page-subtitle">Esta acción no se puede deshacer</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-arca border-danger">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar eliminación
            </div>
            <div class="card-body p-4">
                <p class="mb-3">¿Está seguro que desea eliminar esta cita?</p>

                <dl class="detail-list">
                    <dt>Mascota</dt>
                    <dd>@c.Mascota?.Nombre</dd>
                    <dt>Veterinario</dt>
                    <dd>@c.Veterinario?.NombreCompleto</dd>
                    <dt>Fecha y hora</dt>
                    <dd>@c.FechaHoraAtencion.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt>Motivo</dt>
                    <dd>@c.Motivo</dd>
                    <dt>Estado</dt>
                    <dd>@c.Estado</dd>
                </dl>

                <div class="d-flex gap-2 mt-3">
                    <form method="post">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i> Sí, eliminar
                        </button>
                    </form>
                    <a asp-page="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
