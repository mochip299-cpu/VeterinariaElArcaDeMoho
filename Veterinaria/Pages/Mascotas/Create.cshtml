@page
@model Veterinaria.Pages.Mascotas.CreateModel
@{
    ViewData["Title"] = "Nueva mascota";
}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-plus-circle-fill me-2"></i>Nueva mascota</h1>
    <p class="page-subtitle">Complete los datos de la nueva mascota</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-arca">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Mascota.Nombre" class="form-label fw-semibold"></label>
                            <input asp-for="Mascota.Nombre" class="form-control" placeholder="Ej: Max" autofocus />
                            <span asp-validation-for="Mascota.Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Mascota.PropietarioId" class="form-label fw-semibold"></label>
                            <select asp-for="Mascota.PropietarioId" asp-items="Model.PropietariosSelectList"
                                    class="form-select">
                                <option value="">-- Seleccione propietario --</option>
                            </select>
                            <span asp-validation-for="Mascota.PropietarioId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Mascota.Especie" class="form-label fw-semibold"></label>
                            <input asp-for="Mascota.Especie" class="form-control" placeholder="Ej: Perro, Gato…" />
                            <span asp-validation-for="Mascota.Especie" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Mascota.Raza" class="form-label fw-semibold"></label>
                            <input asp-for="Mascota.Raza" class="form-control" placeholder="Ej: Labrador (opcional)" />
                            <span asp-validation-for="Mascota.Raza" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Mascota.FechaNacimiento" class="form-label fw-semibold"></label>
                            <input asp-for="Mascota.FechaNacimiento" class="form-control" type="date" />
                            <span asp-validation-for="Mascota.FechaNacimiento" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Mascota.Color" class="form-label fw-semibold"></label>
                            <input asp-for="Mascota.Color" class="form-control" placeholder="Ej: Negro con blanco" />
                            <span asp-validation-for="Mascota.Color" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Mascota.Estado" class="form-label fw-semibold"></label>
                            <select asp-for="Mascota.Estado"
                                    asp-items="Html.GetEnumSelectList<Veterinaria.Models.EstadoGeneral>()"
                                    class="form-select"></select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-arca">
                            <i class="bi bi-floppy me-1"></i> Guardar
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
