@page
@model Veterinaria.Pages.Mascotas.IndexModel
@{
    ViewData["Title"] = "Mascotas";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title"><i class="bi bi-heart-fill me-2"></i>Mascotas</h1>
        <p class="page-subtitle">Gestión de mascotas registradas</p>
    </div>
    <a asp-page="Create" class="btn btn-primary btn-arca">
        <i class="bi bi-plus-circle-fill me-1"></i> Nueva mascota
    </a>
</div>

<!-- Búsqueda -->
<div class="card card-arca mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="busqueda" value="@Model.Busqueda"
                           class="form-control" placeholder="Buscar por nombre, especie o raza…" />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
            <div class="col-md-2">
                <a asp-page="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Mascotas.Any())
{
    <div class="empty-state">
        <i class="bi bi-emoji-smile"></i>
        <p>No se encontraron mascotas.</p>
        <a asp-page="Create" class="btn btn-primary btn-arca">Registrar la primera</a>
    </div>
}
else
{
    <div class="card card-arca">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-head-arca">
                    <tr>
                        <th>Nombre</th>
                        <th>Especie / Raza</th>
                        <th>Color</th>
                        <th>Propietario</th>
                        <th class="text-center">Edad</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Mascotas)
                    {
                        <tr>
                            <td class="fw-semibold">@m.Nombre</td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">@m.Especie</span>
                                @if (!string.IsNullOrEmpty(m.Raza))
                                {
                                    <small class="text-muted ms-1">@m.Raza</small>
                                }
                            </td>
                            <td>@m.Color</td>
                            <td>
                                <a asp-page="/Propietarios/Details" asp-route-id="@m.PropietarioId"
                                   class="text-decoration-none">
                                    @m.Propietario?.NombreCompleto
                                </a>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@m.Edad año(s)</span>
                            </td>
                            <td class="text-center">
                                @if (m.Estado == Veterinaria.Models.EstadoGeneral.Activo)
                                {
                                    <span class="badge badge-activo">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactivo">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-page="Details" asp-route-id="@m.Id" class="btn btn-outline-info" title="Ver detalle"><i class="bi bi-eye"></i></a>
                                    <a asp-page="Edit"    asp-route-id="@m.Id" class="btn btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a asp-page="Delete"  asp-route-id="@m.Id" class="btn btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small">@Model.Mascotas.Count mascota(s) encontrada(s)</div>
    </div>
}
