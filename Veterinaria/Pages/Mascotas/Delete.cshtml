@page "{id:int}"
@model Veterinaria.Pages.Mascotas.DeleteModel
@{
    ViewData["Title"] = "Eliminar mascota";
}

<div class="page-header">
    <h1 class="page-title text-danger"><i class="bi bi-trash me-2"></i>Eliminar mascota</h1>
    <p class="page-subtitle">Esta acción no se puede deshacer</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-arca border-danger">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar eliminación
            </div>
            <div class="card-body p-4">
                @if (Model.TieneCitas)
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>
                        <strong>No se puede eliminar.</strong> Esta mascota tiene citas registradas.
                        Primero elimine las citas asociadas.
                    </div>
                }
                else
                {
                    <p class="mb-3">¿Está seguro que desea eliminar esta mascota?</p>
                }

                <dl class="detail-list">
                    <dt>Nombre</dt>
                    <dd>@Model.Mascota!.Nombre</dd>
                    <dt>Especie / Raza</dt>
                    <dd>@Model.Mascota.Especie @(Model.Mascota.Raza != null ? $"/ {Model.Mascota.Raza}" : "")</dd>
                    <dt>Propietario</dt>
                    <dd>@Model.Mascota.Propietario?.NombreCompleto</dd>
                </dl>

                <div class="d-flex gap-2 mt-3">
                    @if (!Model.TieneCitas)
                    {
                        <form method="post">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i> Sí, eliminar
                            </button>
                        </form>
                    }
                    <a asp-page="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
