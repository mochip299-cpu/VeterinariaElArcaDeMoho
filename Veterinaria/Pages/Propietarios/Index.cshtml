@page
@model Veterinaria.Pages.Propietarios.IndexModel
@{
    ViewData["Title"] = "Propietarios";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title"><i class="bi bi-people-fill me-2"></i>Propietarios</h1>
        <p class="page-subtitle">Gestión de propietarios registrados</p>
    </div>
    <a asp-page="Create" class="btn btn-primary btn-arca">
        <i class="bi bi-person-plus-fill me-1"></i> Nuevo propietario
    </a>
</div>

<!-- Búsqueda -->
<div class="card card-arca mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="busqueda" value="@Model.Busqueda"
                           class="form-control" placeholder="Buscar por nombre, apellido, correo o teléfono…" />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
            <div class="col-md-2">
                <a asp-page="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
@if (!Model.Propietarios.Any())
{
    <div class="empty-state">
        <i class="bi bi-person-x-fill"></i>
        <p>No se encontraron propietarios.</p>
        <a asp-page="Create" class="btn btn-primary btn-arca">Registrar el primero</a>
    </div>
}
else
{
    <div class="card card-arca">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-head-arca">
                    <tr>
                        <th>Nombre completo</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th class="text-center">Mascotas</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Propietarios)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@p.NombreCompleto</div>
                            </td>
                            <td><i class="bi bi-telephone me-1 text-muted"></i>@p.Telefono</td>
                            <td><i class="bi bi-envelope me-1 text-muted"></i>@p.Correo</td>
                            <td class="text-center">
                                <span class="badge bg-info-subtle text-info-emphasis rounded-pill">
                                    @p.Mascotas.Count
                                </span>
                            </td>
                            <td class="text-center">
                                @if (p.Estado == Veterinaria.Models.EstadoGeneral.Activo)
                                {
                                    <span class="badge badge-activo">Activo</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactivo">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-page="Details" asp-route-id="@p.Id"
                                       class="btn btn-outline-info" title="Ver detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-page="Edit" asp-route-id="@p.Id"
                                       class="btn btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-page="Delete" asp-route-id="@p.Id"
                                       class="btn btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small">
            @Model.Propietarios.Count propietario(s) encontrado(s)
        </div>
    </div>
}
