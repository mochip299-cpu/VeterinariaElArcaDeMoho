@page "{id:int}"
@model Veterinaria.Pages.Propietarios.EditModel
@{
    ViewData["Title"] = "Editar propietario";
}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-pencil-square me-2"></i>Editar propietario</h1>
    <p class="page-subtitle">Modifique los datos del propietario</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-arca">
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" asp-for="Propietario.Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Propietario.Nombre" class="form-label fw-semibold"></label>
                            <input asp-for="Propietario.Nombre" class="form-control" autofocus />
                            <span asp-validation-for="Propietario.Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Propietario.Apellido" class="form-label fw-semibold"></label>
                            <input asp-for="Propietario.Apellido" class="form-control" />
                            <span asp-validation-for="Propietario.Apellido" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Propietario.Telefono" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Propietario.Telefono" class="form-control" />
                            </div>
                            <span asp-validation-for="Propietario.Telefono" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Propietario.Correo" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Propietario.Correo" class="form-control" />
                            </div>
                            <span asp-validation-for="Propietario.Correo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Propietario.Estado" class="form-label fw-semibold"></label>
                            <select asp-for="Propietario.Estado"
                                    asp-items="Html.GetEnumSelectList<Veterinaria.Models.EstadoGeneral>()"
                                    class="form-select"></select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-arca">
                            <i class="bi bi-floppy me-1"></i> Guardar cambios
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
